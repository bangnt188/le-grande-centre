# Copy to .env.local; this is the only local dev/start/migration/operator envfile.
# Retrieve actual values from the single production Neon branch. Never NEXT_PUBLIC secrets.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
PASSWORD_PREFIX=
CONTACT_RATE_LIMIT_SECRET=
# Full Render endpoint, server-side only. Website key is issued/rotated by bot owner.
NOTIFICATIONS_URL=https://zalo-render-bot.onrender.com/v1/notifications
NOTIFICATIONS_API_KEY=
# Dedicated random secret (>=32 characters), never the website API key.
NOTIFICATION_DISPATCH_SECRET=
# Optional D1 conditional wake scheduler endpoint (/schedules/website); uses NOTIFICATION_DISPATCH_SECRET.
# NOTIFICATION_WAKE_URL=
AWS_ENDPOINT_URL_S3=
AWS_REGION=ap-southeast-1
NEON_MEDIA_FUNCTION_URL=
MEDIA_ORIGIN_SECRET=

# Real R2 bindings are configured in wrangler.jsonc. No S3 credentials needed with bindings.
R2_ACCOUNT_ID=4e577220abb44fa926f2a11b8cf10b55
R2_PRIVATE_BUCKET=mall-documents
NEXT_DIST_DIR=.next-live

# Public URL and indexing are explicit, independent of server credentials.
NEXT_PUBLIC_SITE_URL=https://legrandecentre.vn/
SEO_INDEXABLE=false
# Optional NEXT_PUBLIC_R2_PUBLIC_BASE_URL / NEXT_PUBLIC_NEON_MEDIA_BASE_URL override current assets.

# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are injected into Neon media origin, not browser/Worker.
# MEDIA_ORIGIN_SECRET must match app and origin (>=64 chars); cookie/rate secrets >=32 chars.

# Password operator input for npm run auth:set-password (keep actual values private).
ROOT_ADMIN_EMAIL=root@legrandecentre.vn
ROOT_ADMIN_PASSWORD=
